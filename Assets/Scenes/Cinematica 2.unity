  m_Name: 
  m_EditorClassIdentifier: 
  subtitles:
  - text: "Entr\xE9 sabiendo que ya era tarde..."
    startTime: 0
    duration: 2.5
  - text: "Moloch aun no se llev\xF3 al ni\xF1o..."
    startTime: 2.7
    duration: 2.5
  - text: "Lo parti\xF3 en tres."
    startTime: 5.4
    duration: 1.8
  - text: Tres fragmentos de alma...
    startTime: 7.5
    duration: 2.3
  - text: ocultos en esta casa maldita.
    startTime: 10
    duration: 2.5
  - text: Si quiero salvarlo...
    startTime: 12.8
    duration: 2
  - text: tengo que recuperarlos...
    startTime: 15
    duration: 2.2
  - text: y devolver a Moloch al infierno.
    startTime: 17.5
    duration: 2.5
  subtitleText: {fileID: 2110371003}
  subtitleManager: {fileID: 1537963143}
