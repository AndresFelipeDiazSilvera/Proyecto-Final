--- !u!114 &1152534963
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1152534961}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f0c81cceaad8024b83b2e38152f8e00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  subtitles:
  - text: "Moloch\u2026"
    startTime: 0
    duration: 2.5
  - text: Cuerpo de hombre, cabeza de toro.
    startTime: 2.6
    duration: 3.5
  - text: "Le ofrec\xEDan ni\xF1os... vivos."
    startTime: 6.2
    duration: 3
  - text: "Dec\xEDan que as\xED se tra\xEDa prosperidad."
    startTime: 9.4
    duration: 3.5
  - text: "Lo \xFAnico que trajeron fue muerte."
    startTime: 13.1
    duration: 3
  - text: He cazado cosas peores que hombres.
    startTime: 17
    duration: 2.8
  - text: Demonios, posesiones...
    startTime: 20
    duration: 2
  - text: "Pens\xE9 que ya nada pod\xEDa sorprenderme."
    startTime: 22.3
    duration: 3.5
  - text: "Hoy me contact\xF3 una mujer."
    startTime: 26.5
    duration: 2.5
  - text: "Dice que su hijo desapareci\xF3."
    startTime: 29.2
    duration: 2.2
  - text: Que alguien lo vio entrar a una casa con una anciana.
    startTime: 31.8
    duration: 3.5
  - text: "Pero esa casa lleva a\xF1os vac\xEDa\u2026"
    startTime: 35.5
    duration: 2.8
  - text: "y el olor a azufre est\xE1 m\xE1s fuerte que nunca."
    startTime: 38.6
    duration: 3
  - text: "Si Moloch est\xE1 detr\xE1s de esto\u2026"
    startTime: 42
    duration: 2.5
  - text: lo voy a encontrar.
    startTime: 44.7
    duration: 2
  - text: Y lo voy a devolver al infierno.
    startTime: 47
    duration: 3
  subtitleText: {fileID: 2145248681}
  subtitleManager: {fileID: 1152534963}
